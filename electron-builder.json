{
  "appId": "com.auftools.networktools",
  "productName": "AuF Network Tools",
  "copyright": "Copyright © 2026 AuF Tools",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "dist/**/*",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "src/main/tray-icon.png",
      "to": "tray-icon.png"
    }
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "publisherName": "AuF Tools",
    "verifyUpdateCodeSignature": false,
    "requestedExecutionLevel": "asInvoker"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "allowElevation": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "AuF Network Tools",
    "deleteAppDataOnUninstall": false,
    "runAfterFinish": true,
    "language": "1049"
  },
  "portable": {
    "artifactName": "${productName}-${version}-Portable.${ext}"
  },
  "mac": {
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "category": "public.app-category.utilities",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "dmg": {
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ],
    "window": {
      "width": 540,
      "height": 380
    }
  },
  "linux": {
    "target": [
      {
        "target": "AppImage",
        "arch": ["x64"]
      }
    ],
    "category": "Network",
    "synopsis": "WiFi Network Diagnostic Tools",
    "description": "Professional WiFi network diagnostic and analysis tools",
    "artifactName": "${productName}-${version}.${ext}"
  },
  "compression": "maximum",
  "asar": true,
  "asarUnpack": [
    "**/*.node"
  ]
}
