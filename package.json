{
  "name": "auf-network-tools",
  "version": "1.0.0",
  "description": "Professional network diagnostic and analysis tools with OLED black theme",
  "main": "dist/main/index.js",
  "author": "eXLu51ve",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/eXLu51ve/AuF-Network-Tools.git"
  },
  "bugs": {
    "url": "https://github.com/eXLu51ve/AuF-Network-Tools/issues"
  },
  "homepage": "https://github.com/eXLu51ve/AuF-Network-Tools#readme",
  "scripts": {
    "dev": "electron .",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json && npm run copy:assets",
    "build:renderer": "vite build",
    "copy:assets": "node -e \"require('fs').copyFileSync('src/main/tray-icon.png', 'dist/main/tray-icon.png')\"",
    "start": "npm run build && electron .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:all": "node scripts/test-runner.js",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "prettier": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss}\"",
    "package": "electron-builder",
    "package:win": "electron-builder --win --x64",
    "package:mac": "electron-builder --mac --x64 --arm64",
    "package:linux": "electron-builder --linux --x64",
    "package:all": "electron-builder -mwl",
    "dist": "npm run build && npm run package:all",
    "release": "npm run test:all && npm run dist"
  },
  "keywords": [
    "wifi",
    "network",
    "diagnostics",
    "tools",
    "electron",
    "react",
    "typescript",
    "oled",
    "black-theme"
  ],
  "author": "WiFi Network Tools Team",
  "license": "MIT",
  "devDependencies": {
    "@electron/notarize": "^2.1.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "electron": "^25.0.0",
    "electron-builder": "^24.6.0",
    "electron-updater": "^6.1.0",
    "eslint": "^8.45.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.5.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0"
  },
  "dependencies": {
    "@emotion/react": "^11.11.0",
    "@emotion/styled": "^11.11.0",
    "@mui/icons-material": "^5.14.0",
    "@mui/material": "^5.14.0",
    "@svgr/webpack": "^8.0.0",
    "@types/ssh2": "^1.15.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dns-packet": "^5.6.1",
    "electron-squirrel-startup": "^1.0.1",
    "fast-check": "^3.12.0",
    "framer-motion": "^10.16.0",
    "node-pty": "^1.1.0",
    "node-ssh": "^13.0.0",
    "ping": "^1.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.14.2",
    "recharts": "^3.8.1",
    "ssh2": "^1.17.0",
    "styled-components": "^6.0.0",
    "tcp-port-used": "^1.0.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
